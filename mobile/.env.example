# CraveGuard Mobile Environment Variables Example
# Do not commit real secrets or API keys.

# API Base URL (Desktop / Browser)
API_BASE_URL_DESKTOP=http://localhost:8000/api/v1

# API Base URL (Android Emulator)
API_BASE_URL_ANDROID=http://10.0.2.2:8000/api/v1

# Google Maps API Key
# Web & iOS can also read from environment or native configuration:
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
